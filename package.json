{
  "name": "dsh-agent-im",
  "private": true,
  "version": "0.1.3",
  "license": "MIT",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @dsh-im/web --filter @dsh-im/server --filter @dsh-im/admin dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @dsh-im/shared build && pnpm --filter @dsh-im/client build && pnpm -r typecheck",
    "licenses:generate": "node scripts/licenses/generate-licenses.mjs",
    "licenses:check": "node scripts/licenses/check-licenses.mjs",
    "licenses": "pnpm licenses:generate && pnpm licenses:check"
  }
}
