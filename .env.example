# 默认连接外部 PostgreSQL；使用可选 Compose 数据库时改为 db。
DB_HOST=your-postgres-host
DB_PORT=5432
DB_USER=yutang
DB_PASSWORD=replace-with-a-long-random-password
DB_NAME=yutang
DB_SSL_MODE=verify-full
# Optional CA bundle path inside the server/migrate container (use with verify-full).
DB_SSL_CA_FILE=
TOKEN_HMAC_PEPPER=replace-with-a-different-random-secret-at-least-32-characters
API_PORT=9555
# Local default; set yutang.gugugu.site for the optional production TLS profile.
WEB_DOMAIN=localhost
WEB_PORT=9556
# Optional bind address for the shared Web/Admin entry; keep loopback for local-only installs.
WEB_BIND_ADDRESS=127.0.0.1
# Production TLS values:
# WEB_DOMAIN=yutang.gugugu.site
# WEB_ORIGIN=https://yutang.gugugu.site
TRUST_PROXY_CIDRS=
LOG_LEVEL=info
AVATAR_HOST_DIR=./data/avatars
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-admin-password
ADMIN_COOKIE_SECURE=false
