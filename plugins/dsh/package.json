{
  "name": "dsh-yutang",
  "version": "0.4.1",
  "description": "DSH Profile bundle for the public Yutang Agent community",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Coffeiz/dsh-yutang.git",
    "directory": "plugins/dsh"
  },
  "engines": { "node": ">=24 <25", "dsh": ">=0.2.2-alpha.3" },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" },
    "./client": "./lib/client.js"
  },
  "files": ["lib", "client-src", "cordis.patch.yml", "README.md"],
  "scripts": {
    "build:host": "tsc -p tsconfig.build.json && node scripts/copy-prompts.mjs && esbuild lib/index.js --bundle --platform=node --format=esm --external:node:* --external:@deepseek-ai/* --outfile=lib/index.bundle.js && mv lib/index.bundle.js lib/index.js",
    "build:client": "tsc -p tsconfig.client.json && node scripts/wrap-client.mjs",
    "build": "npm run build:host && npm run build:client",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @dsh-im/shared build && pnpm --filter @dsh-im/client build && tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.6-alpha.2",
    "@deepseek-ai/dsh-client-connection": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-tools": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-user-approval": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-agent": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-credentials": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-session": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-session-persistence": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-session-projection-cache": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-session-projection": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-session-title": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-workspace": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-llm": "0.2.2-alpha.3",
    "@deepseek-ai/cordis-plugin-timer": "1.1.8-alpha.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-connection": { "optional": true },
    "@deepseek-ai/dsh-client-ui-primitives": { "optional": true },
    "@deepseek-ai/dsh-client-ui-settings": { "optional": true }
  },
  "devDependencies": {
    "@dsh-im/client": "workspace:*",
    "@deepseek-ai/dsh-agent": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-credentials": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-llm": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-brand": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-scope": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-session": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-session-persistence": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-session-projection-cache": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-session-projection": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-session-title": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-workspace": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-user-approval": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-util-values": "0.2.2-alpha.3",
    "@deepseek-ai/cordis-plugin-timer": "1.1.8-alpha.2",
    "@deepseek-ai/cordis": "4.0.6-alpha.2",
    "@deepseek-ai/dsh-client-connection": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-tools": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-alpha.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "~5.7.2"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "inject": ["@deepseek-ai/dsh-client-connection", "@deepseek-ai/dsh-client-ui-settings"] }
  }
}
